rules_version = '2';

// ログイン機能を持たないアプリのため、認証(request.auth)によるアクセス制御は
// 使えない。代わりに「4桁の部屋コードを知っている人だけがその部屋にアクセス
// できる」という、部屋コード自体を合言葉がわりにした設計にしている。
// アキネーターバトルと同じ割り切り。問題文・答えはクライアント側に同梱された
// 静的データ(puzzles.js)を参照するだけで、Firestoreには問題IDしか書かない。
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read: if true;
      allow create: if code is string
        && code.size() == 4
        && request.resource.data.code == code
        && request.resource.data.hostId is string;
      allow update: if resource.data.code == code;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
